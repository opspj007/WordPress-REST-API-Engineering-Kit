{
  "name": "your-handle/wordpress-rest-api-engineering-kit",
  "description": "Reference implementation of a production-grade WordPress REST API: versioning, JWT/Application Passwords, rate limiting, RFC 9457 errors, pagination, signed webhooks, OpenAPI.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "squizlabs/php_codesniffer": "^3.9",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": { "psr-4": { "RAEK\\": "includes/" } },
  "autoload-dev": { "psr-4": { "RAEK\\Tests\\": "tests/" } },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit -c phpunit.integration.xml.dist",
    "check": ["@lint", "@test"]
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true } }
}
